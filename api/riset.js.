// api/riset.js - server agen JOY CORPORATION (berjalan di Vercel, kunci aman di server)
const MODEL = 'openai/gpt-oss-120b';

async function ai(system, user, max) {
  const r = await fetch('https://api.groq.com/openai/v1/chat/completions', {
    method: 'POST',
    headers: { Authorization: 'Bearer ' + process.env.GROQ_API_KEY, 'Content-Type': 'application/json' },
    body: JSON.stringify({
      model: MODEL, max_tokens: max || 1200,
      messages: [{ role: 'system', content: system }, { role: 'user', content: user }]
    })
  });
  if (!r.ok) throw new Error('Groq HTTP ' + r.status + ' ' + (await r.text()).slice(0, 150));
  const j = await r.json();
  return ((j.choices && j.choices[0] && j.choices[0].message && j.choices[0].message.content) || '').trim();
}

function toJson(t) {
  const a = t.indexOf('{'), b = t.lastIndexOf('}');
  if (a < 0 || b < 0) throw new Error('format JSON tidak valid');
  return JSON.parse(t.slice(a, b + 1));
}

module.exports = async (req, res) => {
  if (req.method !== 'POST') return res.status(405).json({ error: 'Gunakan POST' });
  if (!process.env.GROQ_API_KEY || !process.env.ADMIN_PIN)
    return res.status(500).json({ error: 'GROQ_API_KEY / ADMIN_PIN belum diisi di Vercel' });
  const body = typeof req.body === 'string' ? JSON.parse(req.body || '{}') : (req.body || {});
  if (String(body.pin) !== process.env.ADMIN_PIN) return res.status(401).json({ error: 'PIN salah' });
  const niche = String(body.niche || '').slice(0, 100) || 'any profitable niche';

  try {
    // 1. Scout + Della: riset
    const r1 = toJson(await ai(
      'You are Scout and Della, digital-product market researchers for Etsy and Gumroad (US/EU buyers). Reply with JSON only.',
      'Niche: ' + niche + '. Propose 3 digital product ideas that AI can write completely (templates, planners, prompt packs, checklists). JSON: {"ideas":[{"title":"","why":""}]}', 700));
    // 2. Validator
    const r2 = toJson(await ai(
      'You are Validator. Reply with JSON only.',
      'Pick the single best idea and score its market potential 0-100. Ideas: ' + JSON.stringify(r1.ideas) + ' JSON: {"title":"","why":"","score":0}', 400));
    // 3. Builder + Sarah: produksi
    const product = await ai(
      'You are Builder and Sarah, expert digital product creators and copywriters. Write in English, Markdown.',
      'Create the complete, ready-to-sell digital product: "' + r2.title + '". Include: product title, a short sales description, and the full product content (usable immediately, no placeholders).', 1800);
    // 4. Michelle: QC
    const r4 = toJson(await ai(
      'You are Michelle, a strict QC reviewer. Reply with JSON only.',
      'Review this product. JSON: {"score":0,"issues":[""],"summary_id":"ringkasan produk dalam bahasa Indonesia, 3 kalimat"} Product: ' + product.slice(0, 6000), 500));

    return res.status(200).json({ niche: niche, idea: r2, product: product, qc: r4 });
  } catch (e) {
    return res.status(500).json({ error: String(e.message || e) });
  }
};

module.exports.config = { maxDuration: 60 };
